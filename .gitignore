# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
.vercel

# design sources
*.psd

# fallow (dead-code analyzer) local state
.fallow/

# claude code local state
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/plans/
.env*
# ...except the tracked list of required keys (no real values in it)
!.env.example

# vitest coverage (input for `fallow audit`, never committed)
coverage/

# commercial material, not development work: the repo tracks what gets built, not what gets
# quoted. These stay on disk — their backup is `backup-locale`, not GitHub, so moving them
# anywhere else under docs/ takes them out of the backup with no warning.
# Blueprints for both, and why they can't ship at these paths: docs/proposal-templates/.
docs/ESTIMATE.md
docs/MEETING-*.md
# PDFs generated from the .md next to them (`md2pdf`), never a source. Deliberately NOT
# recursive: a client PDF under docs/sources/ is a source and stays tracked.
docs/*.pdf

# office temp files — the client's own brief under docs/sources/ stays tracked: it is the source
~$*

# Lighthouse CI local reports
.lighthouseci/
dist/lh-prod/
