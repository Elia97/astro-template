---
import type { HTMLAttributes } from 'astro/types'
import { cva, type VariantProps } from 'class-variance-authority'

import { cn } from '@/lib/utils'

export const buttonVariants = cva(
  'inline-flex cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-md font-medium text-sm transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring active:scale-press disabled:pointer-events-none disabled:opacity-50',
  {
    variants: {
      variant: {
        default: 'bg-primary text-primary-foreground hover:bg-primary/90',
        secondary: 'bg-secondary text-secondary-foreground hover:bg-secondary/80',
        destructive: 'bg-destructive text-destructive-foreground hover:bg-destructive/90',
        outline: 'border border-border bg-background hover:bg-accent hover:text-accent-foreground',
        ghost: 'hover:bg-accent hover:text-accent-foreground',
        link: 'text-primary underline-offset-4 hover:underline',
        accent: 'bg-accent text-accent-foreground hover:bg-accent/90',
        soft: 'border border-transparent bg-foreground/10 hover:bg-foreground/20',
      },
      size: {
        sm: 'h-9 gap-1.5 px-4',
        md: 'h-10 px-5 py-2',
        lg: 'h-11 px-8 text-base',
        xl: 'h-12 px-10 text-base',
        'icon-sm': 'size-9',
        'icon-md': 'size-10',
        'icon-lg': 'size-11',
        'icon-xl': 'size-12',
      },
      shape: {
        default: '',
        pill: 'rounded-full',
      },
    },
    defaultVariants: { variant: 'default', size: 'md', shape: 'default' },
  },
)

// astro check (0.9.x) doesn't resolve generic Props at call sites, so this is an
// explicit discriminated union instead of the docs' Polymorphic pattern.
type Props = VariantProps<typeof buttonVariants> &
  // TypeScript's excess-property check runs against the whole union, so `href` alone
  // compiles without `href?: never`.
  (({ as?: 'button'; href?: never } & HTMLAttributes<'button'>) | ({ as: 'a'; href: string } & HTMLAttributes<'a'>))

const { as: Tag = 'button', variant, size, shape, class: className, ...rest } = Astro.props
const classes = cn(buttonVariants({ variant, size, shape }), className)
---

{
  Tag === 'a' ? (
    <a class={classes} {...(rest as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button class={classes} {...(rest as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}
