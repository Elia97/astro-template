---
// Body of a legal page: centered column + title, content from the page via
// <slot /> (see legal-section-list.astro for the data-driven pattern).
//
// It does NOT mount the layout — the page owns that. A component that wraps
// MainLayout inverts the direction the architecture rests on (layouts compose
// components, never the reverse) and can never be placed inside another layout.
import Container from '@/components/ui/container.astro'
import Section from '@/components/ui/section.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<Section>
  <Container>
    <div class="mx-auto max-w-3xl">
      <h1 class="font-bold text-4xl text-foreground tracking-tight">
        {title}
      </h1>

      <slot />
    </div>
  </Container>
</Section>
