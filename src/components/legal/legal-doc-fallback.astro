---
// Shown when the hosted document isn't available. Deliberately NOT placeholder
// legal prose: draft text on a live /privacy reads as a real policy and is the
// one thing worse than an honest "not available" — it invites shipping it.
import { iubendaHostedUrl, type LegalDocKind } from '@/lib/legal/documents'

interface Props {
  kind: LegalDocKind
}

const { kind } = Astro.props
const title = kind === 'privacy' ? 'Privacy Policy' : 'Cookie Policy'
// null until a policy id is configured — the template's default state.
const hostedUrl = iubendaHostedUrl(kind)
---

<div>
  <h1 class="font-bold text-4xl text-foreground tracking-tight">{title}</h1>
  <p class="mt-6 font-medium text-foreground">Il documento non è al momento disponibile.</p>
  {
    hostedUrl && (
      <>
        <p class="mt-2 text-muted-foreground">
          Puoi consultare la versione ufficiale, sempre aggiornata, alla pagina seguente.
        </p>
        <a
          href={hostedUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-block font-medium text-foreground underline underline-offset-4"
        >
          Apri il documento su iubenda
        </a>
      </>
    )
  }
</div>
