---
// Body of a HOSTED legal document (src/lib/legal/documents.ts): the themed
// document when the fetch returned one, the honest fallback when it did not.
// The branch lives here rather than in each page so both call sites cannot
// drift. Does not mount the layout — see the note in legal-page.astro.
import Container from '@/components/ui/container.astro'
import Section from '@/components/ui/section.astro'

import type { LegalDocKind } from '@/lib/legal/documents'

import LegalDocFallback from './legal-doc-fallback.astro'

interface Props {
  kind: LegalDocKind
  /** Sanitized upstream by getLegalDoc — never pass unsanitized HTML here. */
  html: string | null
}

const { kind, html } = Astro.props

// The iubenda no-markup HTML is semantic but unthemed (it ships its own h1):
// these arbitrary-variant selectors apply the project tokens to the injected
// tags, since the document can't carry classes of its own.
const proseClass = [
  'text-foreground leading-relaxed',
  '[&_h1]:mb-6 [&_h1]:font-bold [&_h1]:text-4xl [&_h1]:tracking-tight',
  '[&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:font-semibold [&_h2]:text-2xl [&_h2]:tracking-tight',
  '[&_h3]:mt-8 [&_h3]:mb-2 [&_h3]:font-semibold [&_h3]:text-xl [&_h3]:tracking-tight',
  '[&_h4]:mt-6 [&_h4]:mb-2 [&_h4]:font-semibold',
  '[&_h5]:mt-4 [&_h5]:mb-1 [&_h5]:font-semibold [&_h5]:text-sm [&_h5]:uppercase [&_h5]:tracking-wide',
  '[&_p]:mb-4 [&_p]:text-muted-foreground',
  '[&_ul]:mb-4 [&_ul]:ml-5 [&_ul]:list-disc [&_ol]:mb-4 [&_ol]:ml-5 [&_ol]:list-decimal [&_li]:mb-1 [&_li]:text-muted-foreground',
  '[&_a]:font-medium [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-4',
  '[&_strong]:font-semibold [&_strong]:text-foreground',
  '[&_hr]:my-8 [&_hr]:border-border',
  '[&_details]:my-3 [&_summary]:cursor-pointer [&_summary]:font-medium',
  '[&_aside]:my-8 [&_aside]:border [&_aside]:border-border [&_aside]:bg-muted/40 [&_aside]:p-6 [&_aside_h2]:mt-0',
].join(' ')
---

<Section>
  <Container>
    <div class="mx-auto max-w-3xl">
      {html !== null ? <div class={proseClass} set:html={html} /> : <LegalDocFallback {kind} />}
    </div>
  </Container>
</Section>
