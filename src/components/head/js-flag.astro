<script is:inline>
  function markJs() {
    document.documentElement.classList.add('js')
  }
  markJs()
  // View transitions don't re-execute inline scripts on the incoming page.
  document.addEventListener('astro:after-swap', markJs)
  // lib/motion/reveal.ts sets `data-reveal-active` as soon as it runs; if that chunk
  // never lands the content stays invisible with no error.
  setTimeout(function () {
    if (!document.documentElement.hasAttribute('data-reveal-active')) {
      document.documentElement.classList.add('reveal-failsafe')
    }
  }, 3000)
</script>
