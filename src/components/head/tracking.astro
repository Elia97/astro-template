---
// The origins these scripts need ship from src/lib/csp/directives.ts: a new vendor
// goes there and in src/lib/csp/csp.test.ts, never in vercel.json.
import { i18n } from 'astro:config/client'

import { getTrackingConfig } from '@/lib/analytics/tracking'

const config = getTrackingConfig()
const lang = Astro.currentLocale ?? i18n?.defaultLocale ?? 'it'
---

{
  config && (
    <>
      {/* Resource hints, split by gate.

          [HARD] dns-prefetch, never preconnect, for googletagmanager: preconnect
          opens TCP+TLS, which sends SNI and the visitor's IP to Google BEFORE
          opt-in — the exact invariant the consent gate exists to hold. A DNS
          lookup only asks the visitor's own resolver.

          iubenda is different: the CMP loads on every page by definition,
          pre-consent, so warming the connection costs nothing that isn't spent
          anyway. No `crossorigin` on either: these load as plain scripts, and
          an anonymous connection wouldn't be reused. */}
      <link rel="preconnect" href="https://cdn.iubenda.com" />
      <link rel="dns-prefetch" href="https://cdn.iubenda.com" />
      <link rel="dns-prefetch" href="https://cs.iubenda.com" />
      <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

      {/* [HARD] Consent Mode defaults, and they must be the FIRST thing to touch
          dataLayer — a tag that queues ahead of them runs unrestricted. Hence
          is:inline and this position: it has to execute synchronously, before
          the module scripts below and before the CMP.

          All four keys start denied; `wait_for_update` gives the CMP 500ms to
          answer before tags act on the default. The gate then sends
          `consent: update` (src/lib/consent/gate.ts) once the user chooses. */}
      <script is:inline>
        window.dataLayer = window.dataLayer || []
        function gtag() {
          window.dataLayer.push(arguments)
        }
        window.gtag = gtag
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          wait_for_update: 500,
        })
        gtag('set', 'ads_data_redaction', true)
        gtag('set', 'url_passthrough', true)
      </script>

      {/* The only seam where server-resolved env reaches the bundled bootstraps
          below — plain data, no logic. */}
      <script
        is:inline
        define:vars={{
          consentConfig: { siteId: config.iubendaSiteId, cookiePolicyId: config.cookiePolicyId, lang },
          analyticsConfig: { gtmId: config.gtmId },
        }}
      >
        window.__consentConfig = consentConfig
        window.__analyticsConfig = analyticsConfig
      </script>

      <script>
        import { bootstrapAnalytics } from '@/lib/analytics/bootstrap'
        import { bootstrapIubenda } from '@/lib/consent/iubenda'

        // Analytics first: a stored preference drains the queue as soon as iubenda
        // loads, and a callback registered after that never runs.
        bootstrapAnalytics()
        bootstrapIubenda()
      </script>
    </>
  )
}
