---
// Anti-FOUC: runs inline in the <head> BEFORE first paint, otherwise the page
// flashes from light to dark. Idempotent and re-runnable on `astro:after-swap`
// (view transitions don't re-execute inline scripts).
---

<script is:inline>
  function syncThemeToggles() {
    const dark = document.documentElement.classList.contains('dark')
    const toggles = document.querySelectorAll('[data-theme-toggle]')
    for (const toggle of toggles) {
      toggle.setAttribute('aria-pressed', dark ? 'true' : 'false')
    }
  }

  function applyTheme() {
    let stored = null
    try {
      stored = localStorage.getItem('theme')
    } catch {
      /* localStorage not accessible: fall back to the system preference */
    }
    const dark = stored
      ? stored === 'dark'
      : window.matchMedia('(prefers-color-scheme: dark)').matches
    document.documentElement.classList.toggle('dark', dark)
    syncThemeToggles()
    syncThemeColor(dark)
  }

  // The two theme-color metas (head/icons.astro) ship with a
  // prefers-color-scheme media query — the right no-JS default, but it ignores
  // the toggle. Flipping `media` to all / not all makes the browser chrome
  // follow the theme actually applied instead of the system preference.
  // NB: this script is `is:inline`, so it lands in the HTML verbatim —
  // comments included. Keep them short and free of markup.
  function syncThemeColor(dark) {
    const metas = document.querySelectorAll('meta[name="theme-color"][data-scheme]')
    for (const meta of metas) {
      const isDarkMeta = meta.getAttribute('data-scheme') === 'dark'
      meta.setAttribute('media', isDarkMeta === dark ? 'all' : 'not all')
    }
  }

  // First load: this runs in <head> before the toggles and the theme-color
  // metas exist, so both syncs must run again once the DOM is there.
  function syncFromDom() {
    syncThemeToggles()
    syncThemeColor(document.documentElement.classList.contains('dark'))
  }

  applyTheme()

  if (!window.__themeInit) {
    window.__themeInit = true
    document.addEventListener('DOMContentLoaded', syncFromDom)
    document.addEventListener('astro:after-swap', applyTheme)
    // Delegated toggle on the document: survives island re-renders and view
    // transitions. Persists the choice in localStorage.
    document.addEventListener('click', function (event) {
      const target = event.target
      const toggle = target && target.closest && target.closest('[data-theme-toggle]')
      if (!toggle) return
      const isDark = document.documentElement.classList.toggle('dark')
      syncThemeToggles()
      syncThemeColor(isDark)
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light')
      } catch {
        /* private mode / blocked cookies: ignore */
      }
    })
  }
</script>
