---
import { SITE } from '@/lib/site'
---

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="manifest" href="/site.webmanifest" />

{/* theme-script.astro matches on `data-scheme` and flips the `media` of these two,
    so the browser chrome follows the toggle and not the system preference. */}
<meta name="theme-color" data-scheme="light" content={SITE.themeColor.light} media="(prefers-color-scheme: light)" />
<meta name="theme-color" data-scheme="dark" content={SITE.themeColor.dark} media="(prefers-color-scheme: dark)" />
