---
import { ClientRouter } from 'astro:transitions'

import Head from '@/components/head/head.astro'
import JsFlag from '@/components/head/js-flag.astro'
import ThemeScript from '@/components/head/theme-script.astro'

import { DEFAULT_LOCALE } from '@/lib/site'

import '@/styles/globals.css'

export interface Props {
  title: string
  absoluteTitle?: boolean
  description?: string
  canonicalPath?: string
  ogImage?: string
  jsonLd?: Record<string, unknown>[]
  locales?: readonly string[]
  class?: string
}

const { title, absoluteTitle, description, canonicalPath, ogImage, jsonLd, locales, class: className } = Astro.props
const lang = Astro.currentLocale ?? DEFAULT_LOCALE
---

<!doctype html>
<html lang={lang} class={className}>
  <head>
    {/* La dichiarazione di codifica deve stare entro i primi 1024 byte del documento, e
        lo script inline del tema qui sotto la spingerebbe oltre. */}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <JsFlag />
    <ThemeScript />
    <Head {title} {absoluteTitle} {description} {canonicalPath} {ogImage} {jsonLd} {locales} />
    <slot name="head" />
    {/* Solo sulle prerenderizzate: con ClientRouter le CSP in meta delle pagine visitate si
        sommano, e quella di una pagina a richiesta copre solo i suoi script (src/middleware.ts). */}
    {Astro.isPrerendered && <ClientRouter />}
  </head>
  <body class="flex min-h-svh flex-col">
    {/* Chi compone il guscio rende <main id="main-content" tabindex="-1">: senza, route-focus.ts esce in silenzio. */}
    <slot />
  </body>
</html>

<script>
  import { bindRouteFocus } from '@/lib/a11y/route-focus'

  bindRouteFocus()
</script>
