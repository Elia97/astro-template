---
import LegalDoc from '@/components/legal/legal-doc.astro'

import MainLayout from '@/layouts/main.astro'

import { getLegalDoc } from '@/lib/legal/documents'

const html = await getLegalDoc('cookie-policy')

const title = 'Cookie Policy'
const description = 'Informativa sull’uso di cookie e tecnologie di memorizzazione locale su questo sito.'
---

<MainLayout {title} {description}>
  <LegalDoc kind="cookie-policy" {html} />
</MainLayout>
