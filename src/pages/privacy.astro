---
// Privacy policy served from iubenda: the no-markup document is fetched at build
// time and rendered as our own sanitized markup — no client script, no CSP change.
// Gated on PUBLIC_IUBENDA_COOKIE_POLICY_ID; until it is set the page shows the
// fallback rather than placeholder legal prose, which on a live page reads as a
// real policy and invites shipping it.
import LegalDoc from '@/components/legal/legal-doc.astro'

import MainLayout from '@/layouts/main.astro'

import { getLegalDoc } from '@/lib/legal/documents'

const html = await getLegalDoc('privacy')

const title = 'Privacy'
const description = 'Informativa sul trattamento dei dati personali ai sensi del Regolamento UE 2016/679 (GDPR).'
---

<MainLayout {title} {description}>
  <LegalDoc kind="privacy" {html} />
</MainLayout>
