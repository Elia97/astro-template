---
import Hero from '@/components/home/hero.astro'

import MainLayout from '@/layouts/main.astro'

import { getHomepageSections } from '@/lib/homepage'
import { buildOrganization, buildWebSite } from '@/lib/seo/json-ld'
import { SITE } from '@/lib/site'

// @gen:home-imports (generators insert new imports ABOVE this line)

const content = await getHomepageSections(Astro.currentLocale)
---

<MainLayout title={SITE.name} description={SITE.description} jsonLd={[buildOrganization(), buildWebSite()]}>
  <Hero {...content.hero} />
  {/* @gen:home-sections */}
</MainLayout>
