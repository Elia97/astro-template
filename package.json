{
  "name": "vetrina",
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "biome:fix": "biome check --write --no-errors-on-unmatched",
    "typecheck": "astro check",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "perf:bundle": "officina check bundle",
    "check:links": "officina check links",
    "check:secrets": "officina check secrets",
    "smoke:prod": "officina check smoke",
    "analytics:verify": "officina check analytics",
    "lhci": "officina check lighthouse",
    "lhci:local": "officina check lighthouse --local",
    "check:deadcode": "fallow dead-code",
    "check:health": "fallow health --complexity",
    "check:comments": "officina check comments --strict",
    "check:language": "officina check language",
    "check:routes": "officina check routes",
    "check:roadmap": "officina check roadmap",
    "check:placeholders": "officina check placeholders",
    "audit:diff": "fallow audit --coverage coverage/coverage-final.json",
    "audit:brief": "fallow review --brief",
    "review": "fallow review --brief",
    "ci": "biome ci --error-on-warnings . && pnpm run typecheck && pnpm run check:deadcode && pnpm run check:language && pnpm run check:routes && pnpm run check:roadmap && pnpm run check:comments && pnpm run doctor && pnpm run test && pnpm run check:health",
    "doctor": "officina doctor",
    "gen": "officina gen",
    "gen:section": "officina gen section",
    "gen:page": "officina gen page",
    "gen:component": "officina gen component",
    "gen:collection": "officina gen collection",
    "gen:icons": "officina gen icons",
    "prepare": "lefthook install --reset-hooks-path || true"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.12",
    "@lucide/astro": "^1.52.0",
    "astro": "^7.3.6",
    "botid": "^1.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@elia97/officina": "^0.12.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "fallow": "^3.32.0",
    "happy-dom": "^20.14.5",
    "lefthook": "^2.2.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.11"
  }
}
